<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textColor="#15182A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="@string/achievements"
                android:textColor="#15182A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAchievementCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/7"
                android:textColor="#5B4CF0"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ACHIEVEMENT PROGRESS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/achievements_unlocked_title"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAchievementPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#5B4CF0"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressAchievements"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvAchievementSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/achievements_loading"
                android:textColor="#858998"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- FEATURED ACHIEVEMENT -->

        <LinearLayout
            android:id="@+id/cardFeaturedAchievement"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_purple_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvFeaturedIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:gravity="center"
                android:text="🏆"
                android:textSize="42sp" />

            <TextView
                android:id="@+id/tvFeaturedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/your_achievements"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFeaturedDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="@string/complete_habits_unlock_badges"
                android:textColor="#E6E3FF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- BADGES -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/your_badges"
            android:textColor="#15182A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- FIRST STEP -->

        <LinearLayout
            android:id="@+id/cardFirstStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconFirstStep"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/first_step"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusFirstStep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/first_step_locked"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 7 DAY WARRIOR -->

        <LinearLayout
            android:id="@+id/cardSevenDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconSevenDay"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seven_day_warrior"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusSevenDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reach_seven_day_streak"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 14 DAY STREAK -->

        <LinearLayout
            android:id="@+id/cardFourteenDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconFourteenDay"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fourteen_day_streak"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusFourteenDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reach_fourteen_day_streak"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 30 DAY CHAMPION -->

        <LinearLayout
            android:id="@+id/cardThirtyDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconThirtyDay"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/thirty_day_champion"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusThirtyDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reach_thirty_day_streak"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ACADEMIC STAR -->

        <LinearLayout
            android:id="@+id/cardAcademicStar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconAcademicStar"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/academic_star"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusAcademicStar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reach_academic_consistency"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- HEALTHY STUDENT -->

        <LinearLayout
            android:id="@+id/cardHealthyStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconHealthyStudent"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/healthy_student"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusHealthyStudent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reach_health_consistency"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- CONSISTENCY MASTER -->

        <LinearLayout
            android:id="@+id/cardConsistencyMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.55"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <TextView
                android:id="@+id/iconConsistencyMaster"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="31sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/consistency_master"
                    android:textColor="#15182A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusConsistencyMaster"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/reach_overall_consistency"
                    android:textColor="#858998"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- PROFILE BUTTON -->

        <Button
            android:id="@+id/btnProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#5B4CF0"
            android:text="@string/view_profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>