<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PURPLE TOP SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="#5142E5"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:text="✓"
                android:textColor="#FFFFFF"
                android:textSize="58sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- MAIN CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="25dp"
            android:paddingEnd="24dp"
            android:paddingBottom="35dp">

            <!-- SMALL BRAND -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#5142E5"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="HabitHub"
                    android:textColor="#5142E5"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Build Better Habits,&#10;Ace Your Goals"
                android:textColor="#15182A"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- DESCRIPTION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="A comprehensive system designed for student growth, health, wellness, and focus."
                android:textColor="#777B8B"
                android:textSize="14sp" />

            <!-- FEATURE 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#EEECFF"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#5142E5"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Track academic, fitness &amp; wellness goals daily"
                    android:textColor="#252839"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FEATURE 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#EEECFF"
                    android:gravity="center"
                    android:text="↗"
                    android:textColor="#5142E5"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Monitor daily trends &amp; progress reports"
                    android:textColor="#252839"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FEATURE 3 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#EEECFF"
                    android:gravity="center"
                    android:text="★"
                    android:textColor="#5142E5"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="Stay focused with reminders &amp; streaks"
                    android:textColor="#252839"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- GET STARTED -->

            <Button
                android:id="@+id/btnGetStarted"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#5142E5"
                android:text="Get Started"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- EXISTING ACCOUNT -->

            <TextView
                android:id="@+id/tvExistingAccount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="I already have an account"
                android:textColor="#5142E5"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>